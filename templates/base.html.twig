<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Gestion - Accueil{% endblock %}</title>
        
        <!-- Google Fonts (Inter) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
       
        
        <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #f8fafc;
                color: #1e293b;
            }
            .navbar {
                background: #ffffff !important;
                border-bottom: 1px solid #e2e8f0;
            }
            .navbar-brand {
                font-weight: 700;
                color: #0f172a !important;
                letter-spacing: -0.025em;
            }
            .nav-link {
                font-weight: 500;
                color: #64748b !important;
                padding: 0.5rem 1rem !important;
                border-radius: 0.375rem;
                transition: all 0.2s ease;
            }
            .nav-link:hover, .nav-link.active {
                color: #0f172a !important;
                background-color: #f1f5f9;
            }
            .card {
                border: 1px solid #e2e8f0;
                border-radius: 0.75rem;
                box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
            }
        </style>
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        
        <!-- Navigation épurée -->
        <header>
            <nav class="navbar navbar-expand-lg sticky-top py-3">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_accueil') }}">
                        <span class="badge bg-primary rounded-pill p-2">⚡</span>
                        <span>Gestion Commandes</span>
                    </a>
                    
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                        <div class="navbar-nav gap-1">
                            <a class="nav-link" href="{{ path('app_client') }}">👥 Clients</a>
                            <a class="nav-link" href="{{ path('app_produit_index') }}">📦 Produits</a>
                            <a class="nav-link" href="{{ path('app_commande') }}">📄 Commandes</a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Contenu principal -->
        <main class="container py-5">
            <!-- Messages Flash -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
                    ✨ {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
                    ⚠️ {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

       
    </body>
</html>