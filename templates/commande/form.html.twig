{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="{{ path('app_commande') }}" class="text-decoration-none text-muted small fw-medium mb-1 d-inline-block">
                    ← Retour aux commandes
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark">{{ titre }}</h1>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.numero, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.numero, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.numero) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.date, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.date) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.client, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.client, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.client) }}
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted">

                <div class="mb-4">
                    <h3 class="h5 fw-bold text-dark mb-3">📦 Produits commandés</h3>
                    
                    <ul id="ligne-commandes-list" class="list-unstyled" data-prototype="{{ form_widget(form.ligneCommandes.vars.prototype)|e('html_attr') }}">
                        {% for ligne in form.ligneCommandes %}
                            <li class="card card-body bg-light border-0 mb-3 p-3">
                                {{ form_row(ligne) }}
                            </li>
                        {% endfor %}
                    </ul>
                    
                    <button type="button" id="add-ligne-btn" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                        <span>➕</span> Ajouter un produit
                    </button>
                </div>

                <!-- Boutons d'action -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="{{ path('app_commande') }}" class="btn btn-light px-4">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">💾 Enregistrer la commande</button>
                </div>

            {{ form_end(form) }}

        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const list = document.getElementById('ligne-commandes-list');
        const addBtn = document.getElementById('add-ligne-btn');
        let index = {{ form.ligneCommandes|length }};

        addBtn.addEventListener('click', function() {
            let prototype = list.dataset.prototype;
            let newForm = prototype.replace(/__name__/g, index);
            
            let li = document.createElement('li');
            li.className = 'card card-body bg-light border-0 mb-3 p-3';
            li.innerHTML = newForm;
            
            list.appendChild(li);
            index++;
        });
    });
</script>
{% endblock %}